#!/usr/bin/env bash
set -euo pipefail

# Install skills from a plugin marketplace repo to:
#   1. Claude Code - register marketplace + enable plugins in ~/.claude/settings.json
#   2. Agent tools - flat-copy skills to ~/.agents/skills/
#      (OpenCode, Codex, Pi, and Kimi Code - all four read ~/.agents/skills/
#      as a user-scope dir; Kimi's parser aliases the same frontmatter spellings)
#
# Usage:
#   install-skills <source-path> [--skills name1,name2] [--claude-only] [--agents-only]
#
# The source path must contain .claude-plugin/marketplace.json.
# Per-source manifests in ~/.agents/skills/.manifest.<marketplace-name>
# prevent cross-pruning when multiple sources share the directory.
# Third-party skills (not in any manifest) are never touched.

DEST="$HOME/.agents/skills"
CLAUDE_SETTINGS="$HOME/.claude/settings.json"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  echo "Usage: install-skills <source-path> [options]"
  echo ""
  echo "Install skills from a plugin marketplace repo."
  echo ""
  echo "Options:"
  echo "  --skills name1,name2   Only install named skills to agents dir"
  echo "  --claude-only          Only register Claude marketplace + plugins"
  echo "  --agents-only          Only install to ~/.agents/skills/"
  echo ""
  echo "The source path must contain .claude-plugin/marketplace.json."
  exit 1
}

# --- parse args ---
SOURCE_PATH=""
SKILLS_FILTER=""
DO_CLAUDE=true
DO_AGENTS=true

while [ $# -gt 0 ]; do
  case "$1" in
    --skills)
      shift
      SKILLS_FILTER="$1"
      ;;
    --claude-only)
      DO_AGENTS=false
      ;;
    --agents-only)
      DO_CLAUDE=false
      ;;
    -h|--help)
      usage
      ;;
    -*)
      echo "unknown option: $1" >&2
      usage
      ;;
    *)
      if [ -n "$SOURCE_PATH" ]; then
        echo "multiple source paths not supported" >&2
        usage
      fi
      SOURCE_PATH="$1"
      ;;
  esac
  shift
done

if [ -z "$SOURCE_PATH" ]; then
  usage
fi

# --- dependency preflight ---
if ! command -v jq >/dev/null 2>&1; then
  echo "error: jq is required to read marketplace metadata" >&2
  exit 1
fi

# resolve to absolute path
SOURCE_PATH="$(cd "$SOURCE_PATH" && pwd)"
PLUGINS_DIR="$SOURCE_PATH/plugins"
MARKETPLACE_JSON="$SOURCE_PATH/.claude-plugin/marketplace.json"

if [ ! -f "$MARKETPLACE_JSON" ]; then
  echo "error: $MARKETPLACE_JSON not found" >&2
  exit 1
fi

# extract marketplace name
MARKETPLACE_NAME="$(jq -r '.name' "$MARKETPLACE_JSON")"
if [ -z "$MARKETPLACE_NAME" ] || [ "$MARKETPLACE_NAME" = "null" ]; then
  echo "error: marketplace.json missing 'name' field" >&2
  exit 1
fi

echo "source: $SOURCE_PATH (marketplace: $MARKETPLACE_NAME)"

# --- Claude registration ---
if [ "$DO_CLAUDE" = true ]; then
  echo ""
  echo "=== Claude Code ==="

  plugin_names="$(jq -r '.plugins[].name' "$MARKETPLACE_JSON")"
  total_plugins="$(echo "$plugin_names" | wc -l | tr -d ' ')"

  if command -v claude >/dev/null 2>&1 && [ "${INSTALL_SKILLS_CLAUDE_CLI:-1}" != "0" ]; then
    echo "using Claude plugin CLI"
    TERM="${TERM:-dumb}" claude plugin marketplace add "$SOURCE_PATH" >/dev/null

    installed=0
    for plugin in $plugin_names; do
      key="${plugin}@${MARKETPLACE_NAME}"
      TERM="${TERM:-dumb}" claude plugin install --scope user "$key" >/dev/null
      echo "  installed/enabled: $key"
      installed=$((installed + 1))
    done

    echo "Claude: $MARKETPLACE_NAME registered, $installed plugin(s) installed/enabled ($total_plugins total)"
  else
    if ! command -v claude >/dev/null 2>&1; then
      echo "Claude CLI not found; falling back to settings.json registration"
    else
      echo "Claude CLI disabled by INSTALL_SKILLS_CLAUDE_CLI=0; falling back to settings.json registration"
    fi

    if [ ! -f "$CLAUDE_SETTINGS" ]; then
      echo "creating $CLAUDE_SETTINGS"
      mkdir -p "$(dirname "$CLAUDE_SETTINGS")"
      echo '{}' > "$CLAUDE_SETTINGS"
    fi

    echo "registering marketplace: $MARKETPLACE_NAME (directory source)"
    jq --arg name "$MARKETPLACE_NAME" --arg path "$SOURCE_PATH" \
      '.extraKnownMarketplaces[$name] = {"source": {"source": "directory", "path": $path}}' \
      "$CLAUDE_SETTINGS" > "$CLAUDE_SETTINGS.tmp" && mv "$CLAUDE_SETTINGS.tmp" "$CLAUDE_SETTINGS"

    # enable all plugins from marketplace.json
    enabled=0
    for plugin in $plugin_names; do
      key="${plugin}@${MARKETPLACE_NAME}"
      already="$(jq -r --arg key "$key" '.enabledPlugins[$key] // empty' "$CLAUDE_SETTINGS")"
      if [ -z "$already" ]; then
        jq --arg key "$key" '.enabledPlugins[$key] = true' \
          "$CLAUDE_SETTINGS" > "$CLAUDE_SETTINGS.tmp" && mv "$CLAUDE_SETTINGS.tmp" "$CLAUDE_SETTINGS"
        echo "  enabled: $key"
        enabled=$((enabled + 1))
      fi
    done

    # verify valid JSON
    if ! jq empty "$CLAUDE_SETTINGS" 2>/dev/null; then
      echo "error: $CLAUDE_SETTINGS is not valid JSON after edits" >&2
      exit 1
    fi

    echo "Claude: $MARKETPLACE_NAME registered, $enabled new plugin(s) enabled ($total_plugins total)"
  fi
fi

# --- Agents flat-copy ---
if [ "$DO_AGENTS" = true ]; then
  echo ""
  echo "=== Agent Skills (~/.agents/skills/) ==="

  if [ ! -d "$PLUGINS_DIR" ]; then
    echo "no plugins/ directory in source - skipping agents install" >&2
    exit 0
  fi

  if ! command -v python3 >/dev/null 2>&1; then
    echo "error: python3 is required to validate skill frontmatter" >&2
    exit 1
  fi
  if ! python3 -c 'import yaml' >/dev/null 2>&1; then
    echo "error: python3 is missing PyYAML (pip install pyyaml)" >&2
    exit 1
  fi

  # collect source skill names
  shopt -s nullglob
  SOURCE_NAMES=()
  name_seen() {
    local needle="$1"
    local n
    [ "${#SOURCE_NAMES[@]}" -gt 0 ] || return 1
    for n in "${SOURCE_NAMES[@]}"; do
      [ "$n" = "$needle" ] && return 0
    done
    return 1
  }

  for skill_dir in "$PLUGINS_DIR"/*/skills/*; do
    [ -d "$skill_dir" ] || continue
    skill_name="$(basename "$skill_dir")"
    # Skills install flat, so two plugins cannot both provide one name.
    if name_seen "$skill_name"; then
      echo "error: duplicate skill name '$skill_name' across plugins; names must be unique" >&2
      exit 1
    fi
    SOURCE_NAMES+=("$skill_name")
  done
  shopt -u nullglob

  if [ "${#SOURCE_NAMES[@]}" -eq 0 ]; then
    echo "no source skills under $PLUGINS_DIR" >&2
    exit 1
  fi

  # Full source inventory, kept before --skills narrows the install set. Prune
  # and manifest decisions must use this, not the filtered list, or a filtered
  # refresh reads every unselected skill as stale.
  SOURCE_ALL=("${SOURCE_NAMES[@]}")

  # apply --skills filter
  if [ -n "$SKILLS_FILTER" ]; then
    IFS=',' read -ra FILTER_NAMES <<< "$SKILLS_FILTER"
    FILTERED=()
    for fname in "${FILTER_NAMES[@]}"; do
      fname="$(echo "$fname" | tr -d ' ')"
      found=false
      for sname in "${SOURCE_NAMES[@]}"; do
        if [ "$sname" = "$fname" ]; then
          FILTERED+=("$sname")
          found=true
          break
        fi
      done
      if [ "$found" = false ]; then
        echo "warning: --skills filter '$fname' not found in source" >&2
      fi
    done
    SOURCE_NAMES=("${FILTERED[@]}")
    if [ "${#SOURCE_NAMES[@]}" -eq 0 ]; then
      echo "error: no skills matched --skills filter" >&2
      exit 1
    fi
  fi

  # validate frontmatter on ALL source skills (not just filtered), against the
  # Agent Skills spec limits. Uses the installer's own copy of the validator so
  # it travels with agent-skills even when installing a third-party source.
  python3 "$SCRIPT_DIR/_check-frontmatter.py" "$PLUGINS_DIR"

  # per-source manifest
  mkdir -p "$DEST"
  manifest="$DEST/.manifest.${MARKETPLACE_NAME}"

  # Names this source previously installed. Anything else already in $DEST owes
  # its presence to another source or a third-party installer and is off limits.
  owned=()
  if [ -f "$manifest" ]; then
    while IFS= read -r old_name; do
      [ -z "$old_name" ] && continue
      owned+=("$old_name")
    done < "$manifest"
  fi

  owned_by_manifest() {
    local needle="$1"
    local n
    [ "${#owned[@]}" -gt 0 ] || return 1
    for n in "${owned[@]}"; do
      [ "$n" = "$needle" ] && return 0
    done
    return 1
  }

  # Preflight every destination before pruning or copying, so a refused
  # collision leaves the install untouched and retryable.
  for skill_name in "${SOURCE_NAMES[@]}"; do
    if [ -d "$DEST/$skill_name" ] && ! owned_by_manifest "$skill_name"; then
      echo "error: $DEST/$skill_name is not owned by marketplace '$MARKETPLACE_NAME'; refusing to overwrite" >&2
      exit 1
    fi
  done

  # prune: only remove skills that THIS source previously installed but no longer provides
  in_source() {
    local needle="$1"
    local n
    for n in "${SOURCE_ALL[@]}"; do
      [ "$n" = "$needle" ] && return 0
    done
    return 1
  }

  pruned=0
  if [ -f "$manifest" ]; then
    while IFS= read -r old_name; do
      [ -z "$old_name" ] && continue
      # The manifest is script-written, but never let a corrupted entry walk
      # outside $DEST.
      if [ "$old_name" != "$(basename "$old_name")" ]; then
        echo "  skipped unsafe manifest entry: $old_name" >&2
        continue
      fi
      if ! in_source "$old_name" && [ -d "$DEST/$old_name" ]; then
        rm -rf "${DEST:?}/${old_name:?}"
        echo "  removed stale: $old_name"
        pruned=$((pruned + 1))
      fi
    done < "$manifest"
  fi

  # copy skills
  installed=0
  for skill_name in "${SOURCE_NAMES[@]}"; do
    src_candidates=( "$PLUGINS_DIR"/*/skills/"$skill_name" )
    src="${src_candidates[0]}"
    if [ -z "$src" ] || [ ! -d "$src" ]; then
      echo "internal error: source dir missing for $skill_name" >&2
      exit 1
    fi
    # Replace rather than merge: a file deleted from the source skill must not
    # survive the copy.
    rm -rf "${DEST:?}/${skill_name:?}"
    mkdir -p "$DEST/$skill_name"
    cp -R "$src"/. "$DEST/$skill_name/"
    installed=$((installed + 1))
    echo "  $skill_name"
  done

  # write manifest: installed this run, plus previously manifested skills the
  # source still provides. A filtered run must not forget the rest.
  manifest_names=("${SOURCE_NAMES[@]}")
  if [ -f "$manifest" ]; then
    while IFS= read -r old_name; do
      [ -z "$old_name" ] && continue
      [ "$old_name" = "$(basename "$old_name")" ] || continue
      if in_source "$old_name"; then
        manifest_names+=("$old_name")
      fi
    done < "$manifest"
  fi
  printf '%s\n' "${manifest_names[@]}" | sort -u > "$manifest"

  echo ""
  echo "Installed $installed skill(s) to $DEST"
  if [ "$pruned" -gt 0 ]; then
    echo "Pruned $pruned stale skill(s)"
  fi
fi
